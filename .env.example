# ─────────────────────────────────────────────────────────────────────────────
# UC Connect — environment variables
# Copy to .env.local (`npm run setup:env`) and fill in your values.
# NEXT_PUBLIC_* vars are exposed to the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# From your hosted Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Public client key. Provide EITHER the anon key OR the newer publishable key.
# The browser client and API fallback accept either one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only service-role key (Settings → API → service_role).
# Required for: payments webhook, wallet top-up, featured settlement,
# admin user/vendor management, and account self-delete. Keep it secret —
# never expose it to the browser. Without it those routes return 503.
SUPABASE_SERVICE_ROLE_KEY=

# ── Midtrans (optional — wallet top-up + featured bidding) ────────────────────
# Leave blank to run without payments: top-up is disabled and the vendor
# "Featured & Dompet" tab shows a not-configured banner. Everything else works.
# Get keys from your Midtrans dashboard (Settings → Access Keys).

# Server-side Snap secret (server-only).
MIDTRANS_SERVER_KEY=
# "true" to hit Midtrans production, anything else uses sandbox (server-side).
MIDTRANS_IS_PRODUCTION=

# Browser Snap client key (loads the Snap popup).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# "true" loads the production Snap script, otherwise the sandbox script.
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=

# ── Transactional email (Resend — required for vendor lifecycle emails) ──────
# Without this, the 90-day vendor activity-confirmation cron logs and skips
# (no auto-archive will ever happen because no email goes out). Get an API
# key from https://resend.com — free tier covers ~3k emails/month.
RESEND_API_KEY=
# Verified "from" address. Example: "UC Connect <noreply@uc-connect.app>".
# Resend requires the domain to be verified before sending.
EMAIL_FROM=

# Public base URL of the deployed app, used to build absolute links inside
# emails (the confirmation link). Without this, links degrade to relative
# paths that won't work outside the user's session. Example:
# NEXT_PUBLIC_APP_URL=https://uc-connect.app (no trailing slash).
NEXT_PUBLIC_APP_URL=

# ── Cron auth (required for the lifecycle jobs) ───────────────────────────────
# Any random string — generate with `openssl rand -base64 32`. The pg_cron
# job sends this in the X-Cron-Secret header when calling
# /api/cron/vendor-confirmation and /api/cron/vendor-auto-archive. Without it
# those routes 503 and the lifecycle loop won't run.
CRON_SECRET=

# ── Rate limiting (optional — distributed/global limits) ──────────────────────
# Without these, rate limiting uses an in-memory per-process counter: a
# best-effort spam guard that is looser on serverless (each instance counts
# separately). Set both to back the limiter with Upstash Redis for a hard,
# global limit shared across all instances. Get them from the Upstash console
# (Redis database → REST API). If a Redis call fails the app falls back to the
# in-memory counter for that request rather than erroring.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
